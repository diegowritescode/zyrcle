# ZyrcleChain v2 parameters. Sourced by the scripts in this folder.
CHAIN_NAME=zyrcle
EVM_CHAIN_ID=20261121          # checked free against chainid.network on 2026-11-21
TOKEN_SYMBOL=ZYR               # 1 ZYR = 1 COP; 1e18 wei = 1 peso
SUBNET_EVM_VERSION=v0.8.0      # genesis template the CLI generates; the node runs the Subnet-EVM shipped with AvalancheGo
AVALANCHE_CLI_VERSION=1.9.6        # used for the local test network
AVALANCHE_CLI_FUJI_VERSION=1.9.7   # installed on the VPS; the CLI is in maintenance mode since Dec 2025
AVALANCHEGO_VERSION=v1.15.3        # node image: avaplatform/subnet-evm:v1.15.3, plugin version 47
ADMIN_GAS_FLOAT_ZYR=100        # genesis balance for the admin's gas; counted as "genesis float"
