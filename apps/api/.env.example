# Google Gemini API key, used for AI route optimization (/api/rutas/optimizar).
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Pinata JWT used by POST /api/evidence to pin collection photos. Server-side only.
PINATA_JWT=

# Allowed browser origins, comma-separated.
CORS_ORIGINS=http://localhost:8080

# Shared secret required in the X-Device-Token header by POST /api/iot/contenedores.
IOT_INGEST_TOKEN=
