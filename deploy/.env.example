# deploy/.env on the VPS. Generated by bootstrap.sh; never commit the real file.
ZYRCLE_API_TAG=<full 40-char commit SHA>
ZYRCLE_WEB_TAG=<full 40-char commit SHA>
# Written by deploy.sh: the same images pinned by digest, which is what compose runs.
ZYRCLE_API_IMAGE=
ZYRCLE_WEB_IMAGE=
API_HOST=zyrcle-backend.deviego.xyz
WEB_HOST=zyrcle.deviego.xyz
BLOCKCHAIN_ID=hXdnq6H8N9gH3o5cpKWGMzspesNyogKjuDwZESQhQNNtM5jN8
TREASURY=0xd7052201140224018b123ecFF7b83B4251790Aeb
ORACLE_KEY_PATH=/home/diego/.avalanche-cli/key/zyrcle-oracle.pk
# The Treasury's OPERATOR_ROLE key, for recording confirmed sales (ADR 0013).
OPERATOR_KEY_PATH=/home/diego/.avalanche-cli/key/zyrcle-operator.pk
DEPLOY_UID=1000
DEPLOY_GID=1000
POSTGRES_PASSWORD=
JWT_SECRET=
OPERATOR_TOKEN=
MQTT_API_PASSWORD=
MQTT_CTR_0001_PASSWORD=
MQTT_CTR_0002_PASSWORD=
MQTT_CTR_0003_PASSWORD=
MQTT_CTR_0004_PASSWORD=

# Optional: Expo access token, if "enhanced security for push notifications" is on (ADR 0008).
# EXPO_ACCESS_TOKEN=

# Optional: smart accounts and lost-phone recovery (ADR 0010). Both are needed for recovery.
# ACCOUNT_FACTORY=<AccountFactory address, from `zyrcle-api chain accounts-deploy`>
# RESEND_API_KEY=<Resend API key with sending access, for the verified domain>
# EMAIL_FROM=Zyrcle <no-reply@zyrcle.deviego.xyz>

# Optional: a permanent public copy of each impact certificate on IPFS (ADR 0027, amendment
# 2026-11-22). Only the JWT; Pinata's API key and secret are not used. Scope it to pinning only.
# PINATA_JWT=<Pinata JWT>

# Optional: error reports to Sentry, without personal data (ADR 0033). The DSN of the API's project.
# SENTRY_DSN_API=<Sentry DSN>

# Optional: encrypted copies off the VPS (ADR 0034, deploy/offsite.sh). The age PUBLIC key (the
# private key stays with Diego, offline) and an S3-compatible bucket, Cloudflare R2 by default.
# OFFSITE_AGE_RECIPIENT=age1...
# OFFSITE_S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
# OFFSITE_S3_BUCKET=zyrcle-backups
# OFFSITE_S3_ACCESS_KEY_ID=<R2 token access key id, object read and write on that bucket only>
# OFFSITE_S3_SECRET_ACCESS_KEY=<its secret>

# Optional: reading scale tickets from a photo with Claude (ADR 0038). An Anthropic API key with a
# monthly spending limit; about US$0.03 per ticket.
# ANTHROPIC_API_KEY=<Anthropic API key>
